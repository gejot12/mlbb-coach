# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# Supabase project settings (Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating /coach/admin (placeholder auth, not real accounts — see plan).
ADMIN_PASSWORD=

# LiquipediaDB API access (apply via the LiquipediaDB Dashboard; approval required).
LIQUIPEDIA_API_KEY=
LIQUIPEDIA_USER_AGENT="MLBBCoach/1.0 (https://your-deployed-domain.example; you@example.com)"

# Shared secret for /api/sync/liquipedia. Must be named exactly CRON_SECRET — Vercel Cron
# auto-injects "Authorization: Bearer <CRON_SECRET>" on scheduled requests when this env
# var exists (see vercel.json). Only needed locally if you want to test the route manually.
CRON_SECRET=
